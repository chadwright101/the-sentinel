{
  "headers": [
    {
      "source": "/api/revalidate",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=1800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
